# ==============================================================================
# Ambiguity-Aware Natural Language Query Engine - Environment Template
# ==============================================================================
# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is gitignored. Never commit real credentials.

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application Secret Key (JWT + internal HMAC, min 32 characters)
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars

# Master Encryption Key (Fernet key used for connection credentials at rest)
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dGhpcy1pcy1hLWR1bW15LWtleS1mb3ItZGV2LW9ubHk=

# Application metadata MongoDB (isolated from target query databases)
APP_MONGO_URI=mongodb://root:appsecret@localhost:27017/nlp_query_engine_meta?authSource=admin
APP_MONGO_DB_NAME=nlp_query_engine_meta

# ------------------------------------------------------------------------------
# LLM provider chain
# ------------------------------------------------------------------------------
# auto = Groq (Qwen) -> Mistral -> Gemini, using whichever keys are present.
# Other values: mock (deterministic, no network), ollama (local inference).
LLM_PROVIDER=auto

# Primary: Groq with a Qwen model.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Secondary: Mistral.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Tertiary: Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Per-provider request timeout. Failed providers fall through to the next one.
LLM_TIMEOUT_SECONDS=45

# Local Ollama (only used when LLM_PROVIDER=ollama)
LLM_MODEL=llama3:8b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Safe Query Execution Controls
MAX_QUERY_EXECUTION_TIME_SECONDS=30
MAX_RESULT_ROWS=1000
MAX_RESULT_BYTES=10485760
ALLOW_WRITE_OPERATIONS=false

# Demo / target databases (local host ports)
DEMO_POSTGRES_URI=postgresql://postgres:postgrespassword@localhost:5432/ecommerce_demo
DEMO_MONGO_URI=mongodb://root:targetsecret@localhost:27018/analytics_demo?authSource=admin
DEMO_ELASTICSEARCH_URL=http://localhost:9200
