# ==============================================================================
# Ambiguity-Aware Natural Language Query Engine - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application Secret Key (Used for JWT and internal HMAC, min 32 characters)
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars

# Master Encryption Key (Used for encrypting connection credentials at rest - Fernet 32 url-safe base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dGhpcy1pcy1hLWR1bW15LWtleS1mb3ItZGV2LW9ubHk=

# Application Metadata MongoDB (Logical isolation from target query databases)
APP_MONGO_URI=mongodb://root:appsecret@localhost:27017/nlp_query_engine_meta?authSource=admin
APP_MONGO_DB_NAME=nlp_query_engine_meta

# LLM & NLP Provider Configuration
# Supported providers: mock, ollama, huggingface
LLM_PROVIDER=mock
LLM_MODEL=llama3:8b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Safe Query Execution Controls
MAX_QUERY_EXECUTION_TIME_SECONDS=30
MAX_RESULT_ROWS=1000
MAX_RESULT_BYTES=10485760 # 10MB
ALLOW_WRITE_OPERATIONS=false

# Demo / Target Databases (for local testing environment)
DEMO_POSTGRES_URI=postgresql://postgres:postgrespassword@localhost:5432/ecommerce_demo
DEMO_MONGO_URI=mongodb://root:targetsecret@localhost:27018/analytics_demo?authSource=admin
DEMO_ELASTICSEARCH_URL=http://localhost:9200
